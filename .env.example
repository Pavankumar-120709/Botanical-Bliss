# Environment variables for Docker Compose
# Copy this file to .env and modify as needed

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/pandac
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=password

# Backend Configuration
SPRING_PROFILES_ACTIVE=docker
JPA_SHOW_URL=false
HIBERNATE_FORMAT_SQL=false

# Port Configuration
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

# File Upload Configuration
FILE_MAX_SIZE=10MB
FILE_MAX_REQUEST_SIZE=10MB

# Clerk Configuration (Replace with your actual keys)
CLERK_ISSUER_URI=https://clerk.botanicalbliss.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_PUBLISHABLE_KEY

# GitHub Configuration (Replace with your actual tokens)
GIT_TOKEN=github_pat_YOUR_GITHUB_TOKEN_HERE
GIT_USERNAME=pandaind
GIT_REPO_URL=https://github.com/pandaind/pandac-store-cdn.git
CDN_BASE_URL=https://cdn.jsdelivr.net/gh